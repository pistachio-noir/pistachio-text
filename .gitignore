/.cache/
/compile_commands.json

# Claude Code: personal settings (shared ones go in .claude/settings.json)
/.claude/settings.local.json

# editors' swap and backup files
*.swp
*~

# Preserve the previous README locally without publishing it
README.backup.md

# Generated social preview assets
/socialpreviews/
